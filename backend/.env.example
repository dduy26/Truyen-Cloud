# Server Configuration
PORT=8080

# Database Configuration (MongoDB Connection String)
# Local Example: mongodb://localhost:27017/cuutruyen_db
# Atlas Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/cuutruyen_db
MONGODB_URI=mongodb://localhost:27017/cuutruyen_db

# JWT Security Configuration (Must be at least 32 characters / 256 bits)
JWT_SECRET=your_jwt_secret_key_change_me_in_production_min_32_chars

# Access Token Expiration: 15 minutes (900000 ms)
JWT_ACCESS_TOKEN_EXPIRATION=900000

# Refresh Token Expiration: 7 days (604800000 ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Redis Configuration (Optional, defaults to localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
